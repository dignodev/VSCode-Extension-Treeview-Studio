{
  "name": "treeview-studio",
  "displayName": "TreeView Studio",
  "description": "Generates a directory tree visualization of your project in an interactive visual interface",
  "version": "0.3.0",
  "publisher": "dignodev",
  "icon": "../UI/Icons/icon-128x128.png",
  "keywords": ["tree", "directory", "folder", "structure", "visualization", "project-tree", "file-tree"],
  "repository": {
    "type": "git",
    "url": "https://github.com/dignodev/treeview-studio.git"
  },
  "bugs": {
    "url": "https://github.com/dignodev/treeview-studio/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:tree-generator.generateTree",
    "onCommand:tree-generator.donate",
    "onCommand:tree-generator.changeLanguage",
    "onCommand:tree-generator.clearCache"
  ],
  "main": "./out/extension.js",
  "sponsor": {
    "url": "https://www.buymeacoffee.com/dignodev"
  },
  "funding": {
    "url": "https://www.buymeacoffee.com/dignodev"
  },
  "resources": {
    "fonts": [
      "resources/fonts/Roboto-Bold.ttf",
      "resources/fonts/Roboto-Regular.ttf",
      "resources/fonts/UbuntuMono-Regular.ttf"
    ]
  },
  "contributes": {
    "commands": [
      {
        "command": "tree-generator.generateTree",
        "title": "%commands.generateTree%",
        "category": "TreeView Studio",
        "icon": "resources/icons/taskbar-icons/save-floppy.svg"
      },
      {
        "command": "tree-generator.donate",
        "title": "%commands.donate%",
        "category": "TreeView Studio",
        "icon": "resources/icons/taskbar-icons/copy-check.svg"
      },
      {
        "command": "tree-generator.changeLanguage",
        "title": "%commands.language%",
        "category": "TreeView Studio",
        "icon": "resources/icons/taskbar-icons/language-square.svg"
      },
      {
        "command": "tree-generator.clearCache",
        "title": "Clear Tree Cache",
        "category": "TreeView Studio",
        "icon": "resources/icons/taskbar-icons/hide-eye.svg"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tree-generator.generateTree",
          "group": "3_workspace@1",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "TreeView Studio",
      "properties": {
        "tree-generator.fontFamily": {
          "type": "string",
          "default": "Consolas, Monaco, Courier New, monospace",
          "description": "%config.fontFamily%"
        },
        "tree-generator.fontSize": {
          "type": "number",
          "default": 13,
          "description": "%config.fontSize%"
        },
        "tree-generator.showIcons": {
          "type": "boolean",
          "default": true,
          "description": "%config.showIcons%"
        },
        "tree-generator.includeHidden": {
          "type": "boolean",
          "default": false,
          "description": "%config.includeHidden%"
        },
        "tree-generator.maxDepth": {
          "type": "number",
          "default": 10,
          "description": "%config.maxDepth%"
        },
        "tree-generator.collapseEntries": {
          "type": "boolean",
          "default": false,
          "description": "%config.collapseEntries%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.x"
  }
}
