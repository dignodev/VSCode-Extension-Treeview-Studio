{
  "name": "tree-generator",
  "displayName": "Tree Generator",
  "description": "Genera un árbol de directorios del proyecto en una interfaz visual interactiva",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:tree-generator.generateTree",
    "onCommand:tree-generator.donate"
  ],
  "main": "./out/extension.js",
  "sponsor": {
    "url": "https://www.buymeacoffee.com/dignodev"
  },
  "funding": {
    "url": "https://www.buymeacoffee.com/dignodev"
  },
  "resources": {
    "fonts": [
      "resources/fonts/Roboto-Bold.ttf"
    ]
  },
  "contributes": {
    "commands": [
      {
        "command": "tree-generator.generateTree",
        "title": "Generar Árbol de Directorios",
        "category": "Tree Generator"
      },
      {
        "command": "tree-generator.donate",
        "title": "Apoyar Tree Generator ☕",
        "category": "Tree Generator"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tree-generator.generateTree",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "Tree Generator",
      "properties": {
        "tree-generator.fontFamily": {
          "type": "string",
          "default": "Consolas, Monaco, Courier New, monospace",
          "description": "Familia de fuente para el árbol de directorios"
        },
        "tree-generator.fontSize": {
          "type": "number",
          "default": 13,
          "description": "Tamaño de fuente para el árbol"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.x"
  }
}