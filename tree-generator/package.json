{
  "name": "tree-generator",
  "displayName": "Tree Generator",
  "description": "Genera un árbol de directorios del proyecto en una interfaz visual interactiva",
  "version": "0.3.0",
  "publisher": "dignodev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:tree-generator.generateTree",
    "onCommand:tree-generator.donate",
    "onCommand:tree-generator.changeLanguage"
  ],
  "main": "./out/extension.js",
  "sponsor": {
    "url": "https://www.buymeacoffee.com/dignodev"
  },
  "funding": {
    "url": "https://www.buymeacoffee.com/dignodev"
  },
  "resources": {
    "fonts": [
      "resources/fonts/Roboto-Bold.ttf",
      "resources/fonts/Roboto-Regular.ttf",
      "resources/fonts/UbuntuMono-Regular.ttf"
    ]
  },
  "contributes": {
    "commands": [
      {
        "command": "tree-generator.generateTree",
        "title": "%commands.generateTree%",
        "category": "Tree Generator"
      },
      {
        "command": "tree-generator.donate",
        "title": "%commands.donate%",
        "category": "Tree Generator"
      },
      {
        "command": "tree-generator.changeLanguage",
        "title": "%commands.language%",
        "category": "Tree Generator"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tree-generator.generateTree",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "Tree Generator",
      "properties": {
        "tree-generator.fontFamily": {
          "type": "string",
          "default": "Consolas, Monaco, Courier New, monospace",
          "description": "%config.fontFamily%"
        },
        "tree-generator.fontSize": {
          "type": "number",
          "default": 13,
          "description": "%config.fontSize%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.x"
  }
}